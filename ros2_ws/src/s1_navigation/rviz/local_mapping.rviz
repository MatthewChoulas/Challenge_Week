Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Reference
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 90; 90; 90
      Alpha: 0.35
    - Class: rviz_default_plugins/PointCloud2
      Name: Local 3D Obstacles
      Enabled: true
      Topic:
        Value: /local_obstacle_cloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Spheres
      Size (m): 0.3
      Color Transformer: FlatColor
      Color: 255; 80; 20
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/Map
      Name: Local Occupancy Grid
      Enabled: true
      Topic:
        Value: /local_occupancy_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.55
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/TF
      Name: Robot Frames
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Show Axes: true
      Show Arrows: true
      Show Names: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 45
      Pitch: 0.75
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
