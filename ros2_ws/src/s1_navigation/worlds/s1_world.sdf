<?xml version="1.0"?>
<sdf version="1.9">

  <world name="s1_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- LIGHT -->

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- GROUND -->

    <model name="ground">
      <static>true</static>

      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ROBOT -->

    <model name="robot" canonical_link="base_link">

      <pose>0 0 0.125 0 0 0</pose>

      <link name="base_link">

        <gravity>true</gravity>

        <inertial>
          <mass>5.0</mass>

          <inertia>
            <ixx>0.2</ixx>
            <iyy>0.2</iyy>
            <izz>0.2</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>


        <!-- LIDAR -->

        <sensor name="lidar" type="gpu_lidar">

          <pose>0 0 0.30 0 0 0</pose>

          <topic>/scan</topic>

          <update_rate>10</update_rate>

          <ray>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>

                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>

              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>

            <range>
              <min>0.10</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>

          <always_on>true</always_on>

          <visualize>true</visualize>

        </sensor>

      </link>

      <!-- Invisible guide links form an x/y/yaw joint chain to the world.
           This physically locks z, roll and pitch while preserving planar motion. -->
      <link name="ground_x_link">
        <inertial><mass>0.01</mass><inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
        </inertia></inertial>
      </link>
      <link name="ground_y_link">
        <inertial><mass>0.01</mass><inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
        </inertia></inertial>
      </link>
      <joint name="ground_x" type="prismatic">
        <parent>world</parent><child>ground_x_link</child>
        <axis><xyz>1 0 0</xyz></axis>
      </joint>
      <joint name="ground_y" type="prismatic">
        <parent>ground_x_link</parent><child>ground_y_link</child>
        <axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="ground_yaw" type="revolute">
        <parent>ground_y_link</parent><child>base_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <plugin
        filename="libs1_planar_drive.so"
        name="s1::PlanarDrive">

        <topic>/model/robot/cmd_vel</topic>

      </plugin>

      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">

        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>

        <odom_publish_frequency>30</odom_publish_frequency>

        <odom_topic>/model/robot/odometry</odom_topic>

      </plugin>

    </model>


  
