<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="robot" canonical_link="base_link">
    <pose>0 0 0.32 0 0 0</pose>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.442708</ixx>
