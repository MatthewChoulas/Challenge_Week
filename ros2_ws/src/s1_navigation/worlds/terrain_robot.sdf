    <plugin filename="s1_terrain_drive" name="s1::TerrainDrive">
      <heightmap_uri>usgs_utah_heightmap.png</heightmap_uri>
      <terrain_size>2000</terrain_size>
      <height_range>73.177490234</height_range>
      <terrain_z_offset>-18.115600586</terrain_z_offset>
      <max_slope_deg>30</max_slope_deg>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/model/robot/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
